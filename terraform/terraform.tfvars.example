region       = "eu-west-1"
project_name = "duckstore"
environment  = "prod"
owner        = "Mohamed Elwishy"

instance_type          = "t3.small"
root_volume_size       = 20
disable_metrics_server = true
domain_name            = "duckstore.example.com"

