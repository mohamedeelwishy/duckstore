# =============================================================================
# Kargo Credentials Secret Template
# =============================================================================
# Instructions:
# 1. Do NOT commit populated secrets to Git.
# 2. Use scripts/setup-secrets.sh or apply directly:
#    kubectl apply -f <populated-secrets-file>
# =============================================================================

apiVersion: v1
kind: Secret
metadata:
  name: github-repo-credentials
  namespace: duckstore
  labels:
    kargo.akuity.io/cred-type: git
type: Opaque
stringData:
  repoURL: https://github.com/mohamedeelwishy/duckstore.git
  username: <GITHUB_USERNAME>
  password: <GITHUB_PERSONAL_ACCESS_TOKEN>

---
apiVersion: v1
kind: Secret
metadata:
  name: ecr-credentials
  namespace: duckstore
  labels:
    kargo.akuity.io/cred-type: image
type: Opaque
stringData:
  repoURL: 307498582744.dkr.ecr.eu-west-1.amazonaws.com
  repoURLIsRegex: "false"
  awsRegion: eu-west-1
  awsAccessKeyID: <AWS_ACCESS_KEY_ID>
  awsSecretAccessKey: <AWS_SECRET_ACCESS_KEY>
