# =============================================================================
# Kargo Credentials Secret Template
# =============================================================================
# Instructions:
# 1. Copy this file to secrets.yaml:
#    cp kargo/secrets.yaml.template kargo/secrets.yaml
# 2. Populate the actual credentials below.
# 3. Apply to your cluster:
#    kubectl apply -f kargo/secrets.yaml
#
# NOTE: Do NOT commit populated secrets to Git!
# =============================================================================

apiVersion: v1
kind: Secret
metadata:
  name: github-repo-credentials
  namespace: duckstore
  labels:
    kargo.akuity.io/cred-type: git
type: Opaque
stringData:
  # Git repository URL for which these credentials apply
  repoURL: https://github.com/mohamedeelwishy/duckstore.git
  # GitHub account username and Personal Access Token (PAT with 'repo' scope)
  username: <GITHUB_USERNAME>
  password: <GITHUB_PERSONAL_ACCESS_TOKEN>

---
apiVersion: v1
kind: Secret
metadata:
  name: ecr-credentials
  namespace: duckstore
  labels:
    kargo.akuity.io/cred-type: image
type: Opaque
stringData:
  # Base registry domain (without repository name or scheme)
  repoURL: 307498582744.dkr.ecr.eu-west-1.amazonaws.com
  awsRegion: eu-west-1
  # AWS IAM credentials with AmazonEC2ContainerRegistryReadOnly access
  # (Optional if Kargo controller utilizes AWS IRSA / EKS Pod Identity)
  awsAccessKeyID: <AWS_ACCESS_KEY_ID>
  awsSecretAccessKey: <AWS_SECRET_ACCESS_KEY>
